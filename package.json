{
  "name": "quiz-versus-mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mock of the MLS quiz app used to trial a live multiplayer (versus) mode",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "check:structure": "node scripts/check-structure.mjs",
    "fixtures:core": "node scripts/make-core-fixtures.mjs",
    "fixtures:validator": "node scripts/make-validator-fixtures.mjs",
    "images:content": "node scripts/make-content-images.mjs",
    "qa:start": "node scripts/qa-server.mjs start",
    "qa:stop": "node scripts/qa-server.mjs stop",
    "qa:ws": "node scripts/qa-ws.mjs",
    "validate:content": "vitest run packages/quiz-validator/test/content.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b",
    "check": "npm run lint && npm run check:structure && npm run format:check && npm run typecheck && npm run test",
    "web:dev": "node scripts/web-dev-server.mjs",
    "test:web": "npm run test:browser -w packages/web"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
