    "correct": 2,
    "randoms": [0.1, 0.9, 0.5],
    "expectedOptions": ["Pinth", "Dromm", "Ozzle", "Kelvar"],
    "expectedCorrect": 2
  },
  {
    "name": "correct stays in place",
    "options": ["Alpha", "Beta", "Gamma", "Delta"],
    "correct": 0,
    "randoms": [0.99, 0.99, 0.99],
    "expectedOptions": ["Alpha", "Beta", "Gamma", "Delta"],
    "expectedCorrect": 0
  },
  {
    "name": "correct option moves to the end",
    "options": ["Alpha", "Beta", "Gamma", "Delta"],
