    "randoms": [0, 0, 0],
    "expectedOptions": ["Beta", "Gamma", "Delta", "Alpha"],
    "expectedCorrect": 3
  },
  {
    "name": "duplicate option text: first match wins",
    "options": ["Same", "Other", "Same", "Third"],
    "correct": 2,
    "randoms": [0.3, 0.6, 0.2],
    "expectedOptions": ["Same", "Same", "Third", "Other"],
    "expectedCorrect": 0
  },
  {
    "name": "two options",
    "options": ["Yes thing", "No thing"],
    "correct": 1,
    "randoms": [0.4],
    "expectedOptions": ["No thing", "Yes thing"],
